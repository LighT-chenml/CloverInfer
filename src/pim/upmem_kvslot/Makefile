BUILD_DIR ?= build
NR_TASKLETS ?= 16
NUM_DPUS ?= 2
KVSLOT_MAX_HEADS ?= 32
KVSLOT_MAX_BATCH_ITEMS ?= 32
KVSLOT_MAX_CAPACITY ?= 256
KVSLOT_EXPERIMENTAL_INT8_I16_QK ?= 0
KVSLOT_SLIM_QK_SLOT_ONLY ?= 0
KVSLOT_BULK_FP16_DOT ?= 0
KVSLOT_EXPERIMENTAL_INT16_KV ?= 0
KVSLOT_CONTEXT_BULK_ROW ?= 0
KVSLOT_CONTEXT_OCTETV ?= 0
KVSLOT_CONTEXT_TILE16 ?= 0
KVSLOT_CONTEXT_INT8_I16_WEIGHTS ?= 0
KVSLOT_QK_MAX_ACTIVE_DPUS ?= 16
KVSLOT_DPU_OPT ?= -O2

DPU_CC ?= dpu-upmem-dpurte-clang
HOST_CC ?= cc
PKG_CONFIG ?= dpu-pkg-config
KVSLOT_LIMIT_FLAGS := -DKVSLOT_MAX_HEADS=$(KVSLOT_MAX_HEADS) -DKVSLOT_MAX_BATCH_ITEMS=$(KVSLOT_MAX_BATCH_ITEMS) -DKVSLOT_MAX_CAPACITY=$(KVSLOT_MAX_CAPACITY) -DKVSLOT_QK_MAX_ACTIVE_DPUS=$(KVSLOT_QK_MAX_ACTIVE_DPUS)
KVSLOT_EXPERIMENTAL_FLAGS :=
ifeq ($(KVSLOT_EXPERIMENTAL_INT8_I16_QK),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_EXPERIMENTAL_INT8_I16_QK
endif
ifeq ($(KVSLOT_SLIM_QK_SLOT_ONLY),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_SLIM_QK_SLOT_ONLY
endif
ifeq ($(KVSLOT_BULK_FP16_DOT),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_BULK_FP16_DOT
endif
ifeq ($(KVSLOT_EXPERIMENTAL_INT16_KV),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_EXPERIMENTAL_INT16_KV
endif
ifeq ($(KVSLOT_CONTEXT_BULK_ROW),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_CONTEXT_BULK_ROW
endif
ifeq ($(KVSLOT_CONTEXT_OCTETV),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_CONTEXT_OCTETV
endif
ifeq ($(KVSLOT_CONTEXT_TILE16),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_CONTEXT_TILE16
endif
ifeq ($(KVSLOT_CONTEXT_INT8_I16_WEIGHTS),1)
KVSLOT_EXPERIMENTAL_FLAGS += -DKVSLOT_CONTEXT_INT8_I16_WEIGHTS
endif

DPU_TARGET := $(BUILD_DIR)/dpu_kvslot
HOST_TARGET := $(BUILD_DIR)/host_kvslot

.PHONY: all clean

all: $(DPU_TARGET) $(HOST_TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(DPU_TARGET): dpu_kvslot.c common.h | $(BUILD_DIR)
	$(DPU_CC) $(KVSLOT_DPU_OPT) -DNR_TASKLETS=$(NR_TASKLETS) $(KVSLOT_LIMIT_FLAGS) $(KVSLOT_EXPERIMENTAL_FLAGS) -I. -o $@ dpu_kvslot.c

$(HOST_TARGET): host_kvslot.c common.h $(DPU_TARGET) | $(BUILD_DIR)
	$(HOST_CC) -O2 -Wall -Wextra $(KVSLOT_LIMIT_FLAGS) $(KVSLOT_EXPERIMENTAL_FLAGS) -I. -DDPU_BINARY=\"$(abspath $(DPU_TARGET))\" -o $@ host_kvslot.c $(shell $(PKG_CONFIG) --cflags --libs dpu) -lm

clean:
	rm -rf $(BUILD_DIR)
